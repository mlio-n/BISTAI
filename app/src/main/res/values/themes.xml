<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bistai.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_glyph</item>
        <item name="postSplashScreenTheme">@style/Theme.BISTAI.Main</item>
    </style>

    <style name="Theme.BISTAI.Main" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
    </style>
</resources>
